# Application
NODE_ENV=dev
PORT=3000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3001

# Documentation Swagger
ENABLE_SWAGGER=true
SWAGGER_USERNAME=agriflow
SWAGGER_PASSWORD=agriflow2026

# Database PostgreSQL + PostGIS
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNC=false
DB_SSL=false
DB_LOGGING=true

# Redis / BullMQ
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Auth
JWT_SECRET=agriflow_dev_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=agriflow_dev_super_refresh_secret_key_2026
JWT_ACCESS_EXPIRATION_TIME=7d
JWT_REFRESH_EXPIRATION_TIME=30d
OTP_EXPIRATION_MINUTES=10
